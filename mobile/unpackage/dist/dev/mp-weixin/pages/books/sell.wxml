<view class="container data-v-4704ad50"><view class="card form-card card-top-amber data-v-4704ad50"><view class="input-group data-v-4704ad50"><text class="input-label data-v-4704ad50">书名 <text class="required data-v-4704ad50">*</text></text><input class="input data-v-4704ad50" placeholder="请输入教材名称" data-event-opts="{{[['input',[['__set_model',['$0','title','$event',[]],['form']]]]]}}" value="{{form.title}}" bindinput="__e"/></view><view class="input-group data-v-4704ad50"><text class="input-label data-v-4704ad50">作者 <text class="required data-v-4704ad50">*</text></text><input class="input data-v-4704ad50" placeholder="请输入作者" data-event-opts="{{[['input',[['__set_model',['$0','author','$event',[]],['form']]]]]}}" value="{{form.author}}" bindinput="__e"/></view><view class="input-group data-v-4704ad50"><text class="input-label data-v-4704ad50">出版社 <text class="required data-v-4704ad50">*</text></text><input class="input data-v-4704ad50" placeholder="请输入出版社" data-event-opts="{{[['input',[['__set_model',['$0','publisher','$event',[]],['form']]]]]}}" value="{{form.publisher}}" bindinput="__e"/></view><view class="input-group data-v-4704ad50"><text class="input-label data-v-4704ad50">ISBN</text><input class="input data-v-4704ad50" placeholder="选填" data-event-opts="{{[['input',[['__set_model',['$0','isbn','$event',[]],['form']]]]]}}" value="{{form.isbn}}" bindinput="__e"/></view><view class="input-group data-v-4704ad50"><text class="input-label data-v-4704ad50">学院 <text class="required data-v-4704ad50">*</text></text><picker range="{{categories}}" range-key="name" data-event-opts="{{[['change',[['onCategoryChange',['$event']]]]]}}" bindchange="__e" class="data-v-4704ad50"><view class="picker-view data-v-4704ad50">{{categoryName||'请选择学院'}}</view></picker></view><view class="input-group data-v-4704ad50"><text class="input-label data-v-4704ad50">成色 <text class="required data-v-4704ad50">*</text></text><picker range="{{conditions}}" data-event-opts="{{[['change',[['onConditionChange',['$event']]]]]}}" bindchange="__e" class="data-v-4704ad50"><view class="picker-view data-v-4704ad50">{{conditionLabel||'请选择成色'}}</view></picker></view><view class="input-group data-v-4704ad50"><text class="input-label data-v-4704ad50">定价 <text class="required data-v-4704ad50">*</text></text><input class="input data-v-4704ad50" type="digit" placeholder="请输入教材原价" data-event-opts="{{[['input',[['__set_model',['$0','original_price','$event',[]],['form']]]]]}}" value="{{form.original_price}}" bindinput="__e"/></view><view class="input-group data-v-4704ad50"><text class="input-label data-v-4704ad50">补充说明</text><textarea class="textarea data-v-4704ad50" placeholder="选填，最多500字" maxlength="500" data-event-opts="{{[['input',[['__set_model',['$0','description','$event',[]],['form']]]]]}}" value="{{form.description}}" bindinput="__e"></textarea></view><view class="input-group data-v-4704ad50"><text class="input-label data-v-4704ad50">上传图片（2-5张，需含封面）</text><view class="image-upload data-v-4704ad50"><block wx:for="{{images}}" wx:for-item="img" wx:for-index="idx" wx:key="idx"><view data-event-opts="{{[['tap',[['removeImage',[idx]]]]]}}" class="image-item data-v-4704ad50" bindtap="__e"><image class="upload-img data-v-4704ad50" src="{{img}}" mode="aspectFill"></image><text class="remove-icon data-v-4704ad50">×</text></view></block><block wx:if="{{$root.g0<5}}"><view data-event-opts="{{[['tap',[['chooseImage',['$event']]]]]}}" class="add-btn data-v-4704ad50" bindtap="__e"><text class="add-icon data-v-4704ad50">+</text><text class="add-text data-v-4704ad50">{{$root.g1?''+$root.g2+'/5':'添加图片'}}</text></view></block></view><block wx:if="{{$root.g3<2}}"><text class="hint data-v-4704ad50">请至少上传2张图片（含封面+内页）</text></block></view><view data-event-opts="{{[['tap',[['onSubmit',['$event']]]]]}}" class="btn-amber submit-btn data-v-4704ad50" bindtap="__e">提交审核</view></view></view>