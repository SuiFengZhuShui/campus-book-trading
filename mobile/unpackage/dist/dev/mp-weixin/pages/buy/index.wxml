<view class="container data-v-753d1760"><block wx:if="{{loading}}"><view class="status-msg data-v-753d1760">加载中...</view></block><block wx:else><block wx:if="{{book}}"><view class="card card-accent-amber data-v-753d1760"><view class="book-row data-v-753d1760"><block wx:if="{{book.cover_img}}"><image class="cover data-v-753d1760" src="{{book.cover_img}}" mode="aspectFill"></image></block><view class="book-info data-v-753d1760"><text class="title ellipsis-2 data-v-753d1760">{{book.title}}</text><text class="meta data-v-753d1760">{{book.author}}</text><text class="price data-v-753d1760">{{"¥"+book.price}}</text></view></view></view><view class="card data-v-753d1760"><text class="section-title data-v-753d1760">取书地点</text><input class="input data-v-753d1760" placeholder="请填写取书地点，如图书馆门口" data-event-opts="{{[['input',[['__set_model',['','pickupLocation','$event',[]]]]]]}}" value="{{pickupLocation}}" bindinput="__e"/></view><view class="card data-v-753d1760"><text class="section-title data-v-753d1760">下单须知</text><view class="notice data-v-753d1760"><text class="notice-item data-v-753d1760">1. 下单后请在24小时内完成支付，超时订单将自动取消</text><text class="notice-item data-v-753d1760">2. 付款后平台客服会联系你确认取书时间和地点</text><text class="notice-item data-v-753d1760">3. 取书时请当场验书，确认无误后再确认取书</text><text class="notice-item data-v-753d1760">4. 确认取书后订单完结，不再支持退款</text></view></view><view data-event-opts="{{[['tap',[['onSubmit',['$event']]]]]}}" class="btn-amber submit-btn data-v-753d1760" bindtap="__e">{{"确认下单 ¥"+book.price}}</view></block></block></view>