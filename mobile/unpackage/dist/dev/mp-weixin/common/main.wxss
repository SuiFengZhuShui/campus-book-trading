@charset "UTF-8";
/* 校园二手书 uni-app 全局样式 */
uni-page-body {
  background-color: #faf8f5 !important;
}
page {
  background-color: #faf8f5;
  color: #1a1f2b;
  font-size: 15px;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}
/* ====== 按钮 ====== */
.btn-primary {
  background: linear-gradient(135deg, #1e3a5f, #2c5282);
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 12px 24px;
  font-size: 16px;
}
.btn-amber {
  background: linear-gradient(135deg, #c7915c, #d4a574);
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 12px 24px;
  font-size: 16px;
}
.btn-teal {
  background: linear-gradient(135deg, #0d9488, #14b8a6);
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 12px 24px;
  font-size: 16px;
}
.btn-outline {
  background: #fff;
  color: #1e3a5f;
  border: 1px solid #1e3a5f;
  border-radius: 8px;
  padding: 10px 20px;
  font-size: 14px;
}
.btn-danger {
  background: #bc4742;
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 10px 20px;
  font-size: 14px;
}
/* ====== 颜色工具类 ====== */
.text-amber {
  color: #c7915c;
}
.text-teal {
  color: #0d9488;
}
.text-coral {
  color: #e07b5a;
}
.text-indigo {
  color: #5b7fbd;
}
.text-danger {
  color: #bc4742;
}
.text-success {
  color: #2d6a4f;
}
.text-muted {
  color: #9d9fa8;
}
.text-dark {
  color: #1a1f2b;
}
/* ====== 价格 ====== */
.price {
  color: #c7915c;
  font-weight: 700;
}
.price-original {
  color: #9d9fa8;
  text-decoration: line-through;
  font-size: 13px;
}
/* ====== 卡片 ====== */
.card {
  background: #fffdfa;
  border-radius: 12px;
  border: 1px solid #f0ede7;
  overflow: hidden;
}
/* 卡片左侧彩色装饰条 */
.card-accent-blue {
  border-left: 3px solid #1e3a5f;
}
.card-accent-amber {
  border-left: 3px solid #c7915c;
}
.card-accent-teal {
  border-left: 3px solid #0d9488;
}
.card-accent-coral {
  border-left: 3px solid #e07b5a;
}
.card-accent-indigo {
  border-left: 3px solid #5b7fbd;
}
.card-accent-green {
  border-left: 3px solid #2d6a4f;
}
.card-accent-red {
  border-left: 3px solid #bc4742;
}
.card-accent-gray {
  border-left: 3px solid #9d9fa8;
}
/* 卡片顶部彩色条 */
.card-top-teal {
  border-top: 3px solid #0d9488;
}
.card-top-amber {
  border-top: 3px solid #c7915c;
}
/* ====== 渐变头部 ====== */
.gradient-blue-indigo {
  background: linear-gradient(160deg, #1e3a5f 0%, #2c5282 50%, #5b7fbd 100%);
}
.gradient-blue-teal {
  background: linear-gradient(160deg, #1e3a5f 0%, #2c5282 40%, #0d9488 100%);
}
.gradient-amber-coral {
  background: linear-gradient(135deg, #c7915c, #e07b5a);
}
/* ====== 标签 ====== */
.badge-success {
  background: #f0fdf4;
  color: #2d6a4f;
  padding: 2px 8px;
  border-radius: 12px;
  font-size: 12px;
}
.badge-warning {
  background: #fefce8;
  color: #b0822c;
  padding: 2px 8px;
  border-radius: 12px;
  font-size: 12px;
}
.badge-danger {
  background: #fef2f2;
  color: #bc4742;
  padding: 2px 8px;
  border-radius: 12px;
  font-size: 12px;
}
.badge-info {
  background: #eff6ff;
  color: #1e3a5f;
  padding: 2px 8px;
  border-radius: 12px;
  font-size: 12px;
}
.badge-teal {
  background: #f0fdfa;
  color: #0d9488;
  padding: 2px 8px;
  border-radius: 12px;
  font-size: 12px;
}
.badge-coral {
  background: #fff7f5;
  color: #e07b5a;
  padding: 2px 8px;
  border-radius: 12px;
  font-size: 12px;
}
.badge-indigo {
  background: #f0f4ff;
  color: #5b7fbd;
  padding: 2px 8px;
  border-radius: 12px;
  font-size: 12px;
}
/* ====== 间距 ====== */
.mt-8 {
  margin-top: 8px;
}
.mt-12 {
  margin-top: 12px;
}
.mt-16 {
  margin-top: 16px;
}
.mt-20 {
  margin-top: 20px;
}
.mb-8 {
  margin-bottom: 8px;
}
.mb-12 {
  margin-bottom: 12px;
}
.mb-16 {
  margin-bottom: 16px;
}
.p-12 {
  padding: 12px;
}
.p-16 {
  padding: 16px;
}
.p-20 {
  padding: 20px;
}
/* ====== 通用布局 ====== */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.flex-col {
  display: flex;
  flex-direction: column;
}
.flex-1 {
  flex: 1;
}
.text-center {
  text-align: center;
}
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
/* ====== 分割线 ====== */
.divider {
  height: 1px;
  background: #f0ede7;
  margin: 12px 0;
}
/* ====== 空状态 ====== */
.empty-state {
  text-align: center;
  padding: 60px 20px;
  color: #9d9fa8;
  font-size: 14px;
}
