{
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Bash",
      "WebSearch",
      "WebFetch"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "php -l \"$FILE_PATH\" 2>&1"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd C:/Users/Administrator/Desktop/Schoolcampus-books/backend && php -r \"echo 'app ok';\" 2>&1 && curl -s -o /dev/null -w 'http_status:%{http_code}' http://127.0.0.1/ 2>&1"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd C:/Users/Administrator/Desktop/Schoolcampus-books/frontend && npm run build 2>&1"
          }
        ]
      }
    ]
  }
}