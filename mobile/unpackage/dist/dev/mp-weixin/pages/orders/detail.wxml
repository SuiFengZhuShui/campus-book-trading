<view class="container data-v-4ee14192"><block wx:if="{{loading}}"><view class="status-msg data-v-4ee14192">加载中...</view></block><block wx:else><block wx:if="{{order}}"><view class="card data-v-4ee14192"><view class="order-header data-v-4ee14192"><text class="order-no data-v-4ee14192">{{order.order_no}}</text><text class="{{['data-v-4ee14192','status-tag',$root.m0]}}">{{order.status_label}}</text></view><view class="books-section data-v-4ee14192"><block wx:for="{{order.books}}" wx:for-item="b" wx:for-index="__i0__" wx:key="book_id"><view class="book-row data-v-4ee14192"><text class="book-title data-v-4ee14192">{{b.title}}</text><block wx:if="{{b.price}}"><text class="book-price data-v-4ee14192">{{"¥"+b.price}}</text></block><block wx:else><text class="book-price-pending data-v-4ee14192">审核中，待定价</text></block></view></block></view><view class="info-row data-v-4ee14192"><text class="label data-v-4ee14192">取书地点</text><text class="value data-v-4ee14192">{{order.pickup_location}}</text></view><view class="divider data-v-4ee14192"></view><view class="info-row data-v-4ee14192"><text class="label data-v-4ee14192">合计金额</text><block wx:if="{{order.total_amount}}"><text class="amount data-v-4ee14192">{{"¥"+order.total_amount}}</text></block><block wx:else><text class="amount-pending data-v-4ee14192">审核中，待定价</text></block></view><view class="info-row mt-12 data-v-4ee14192"><text class="label data-v-4ee14192">下单时间</text><text class="value data-v-4ee14192">{{order.created_at}}</text></view></view><block wx:if="{{order.seller}}"><view class="card data-v-4ee14192"><text class="section-title data-v-4ee14192">卖家信息</text><view class="info-row data-v-4ee14192"><text class="label data-v-4ee14192">姓名</text><text class="value data-v-4ee14192">{{order.seller.name}}</text></view><view class="info-row mt-12 data-v-4ee14192"><text class="label data-v-4ee14192">手机号</text><text class="value data-v-4ee14192">{{order.seller.phone}}</text></view></view></block><block wx:if="{{$root.g0}}"><view class="card data-v-4ee14192"><text class="section-title data-v-4ee14192">订单轨迹</text><block wx:for="{{$root.l0}}" wx:for-item="t" wx:for-index="idx" wx:key="idx"><view class="timeline-item data-v-4ee14192"><view class="{{['data-v-4ee14192','dot',idx===0?'dot-active':'']}}"></view><view class="timeline-content data-v-4ee14192"><text class="timeline-status data-v-4ee14192">{{t.m1}}</text><text class="timeline-date data-v-4ee14192">{{t.$orig.created_at}}</text></view></view></block></view></block><block wx:if="{{order.is_buyer}}"><view class="actions data-v-4ee14192"><block wx:if="{{order.status==='pending'}}"><view data-event-opts="{{[['tap',[['onCancel',['$event']]]]]}}" class="btn-danger action-btn data-v-4ee14192" bindtap="__e">取消订单</view></block><block wx:if="{{order.status==='pending'}}"><view data-event-opts="{{[['tap',[['onPay',['$event']]]]]}}" class="btn-amber action-btn data-v-4ee14192" bindtap="__e">立即支付</view></block><block wx:if="{{order.status==='paid'}}"><view data-event-opts="{{[['tap',[['onPickup',['$event']]]]]}}" class="btn-amber action-btn data-v-4ee14192" bindtap="__e">确认取书</view></block><block wx:if="{{order.status==='picked_up'}}"><view data-event-opts="{{[['tap',[['goReview',['$event']]]]]}}" class="btn-primary action-btn data-v-4ee14192" bindtap="__e">去评价</view></block></view></block><block wx:if="{{(order.status==='cancelled'||order.status==='picked_up')&&(order.is_buyer||order.is_seller)}}"><view class="actions data-v-4ee14192"><view data-event-opts="{{[['tap',[['onDelete',['$event']]]]]}}" class="btn-danger action-btn data-v-4ee14192" bindtap="__e">删除订单</view></view></block></block></block></view>