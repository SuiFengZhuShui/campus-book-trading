<view class="container data-v-64c291de"><block wx:if="{{!$root.g0}}"><view class="login-card data-v-64c291de"><view class="card data-v-64c291de" style="text-align:center;padding:40px 20px;"><view class="login-avatar data-v-64c291de"><text class="login-avatar-text data-v-64c291de">📚</text></view><text class="login-title data-v-64c291de">校园二手书</text><text class="login-sub data-v-64c291de">登录后享受便捷的二手教材交易</text><view data-event-opts="{{[['tap',[['goLogin',['$event']]]]]}}" class="btn-amber mt-20 data-v-64c291de" style="padding:10px 40px;display:inline-block;" bindtap="__e">登录</view><view class="mt-12 data-v-64c291de"><text data-event-opts="{{[['tap',[['goRegister',['$event']]]]]}}" class="link data-v-64c291de" bindtap="__e">没有账号？去注册</text></view></view></view></block><block wx:else><view class="user-header data-v-64c291de"><view class="header-bg data-v-64c291de"></view><view class="header-content data-v-64c291de"><view class="avatar data-v-64c291de"><text class="avatar-text data-v-64c291de">{{avatarText}}</text></view><text class="user-name data-v-64c291de">{{auth.user.name}}</text><text class="user-detail data-v-64c291de">{{"学号 "+(auth.user.student_id||'未设置')}}</text><text class="user-detail data-v-64c291de">{{maskedPhone}}</text></view></view><view class="stats-row data-v-64c291de"><view data-event-opts="{{[['tap',[['goOrdersFilter',['pending']]]]]}}" class="stat-card data-v-64c291de" bindtap="__e"><text class="stat-num data-v-64c291de">{{stats.order_pending}}</text><text class="stat-label data-v-64c291de">待付款</text></view><view data-event-opts="{{[['tap',[['goOrdersFilter',['paid']]]]]}}" class="stat-card data-v-64c291de" bindtap="__e"><text class="stat-num data-v-64c291de">{{stats.order_paid}}</text><text class="stat-label data-v-64c291de">已付款</text></view><view data-event-opts="{{[['tap',[['goOrdersFilter',['confirmed']]]]]}}" class="stat-card data-v-64c291de" bindtap="__e"><text class="stat-num data-v-64c291de">{{stats.order_confirmed}}</text><text class="stat-label data-v-64c291de">待取书</text></view><view data-event-opts="{{[['tap',[['goOrdersFilter',['picked_up']]]]]}}" class="stat-card data-v-64c291de" bindtap="__e"><text class="stat-num data-v-64c291de">{{stats.order_done}}</text><text class="stat-label data-v-64c291de">已完成</text></view></view><view class="section data-v-64c291de"><text class="section-title data-v-64c291de">交易管理</text><view class="menu-card card data-v-64c291de"><view data-event-opts="{{[['tap',[['goOrders',['$event']]]]]}}" class="menu-item data-v-64c291de" bindtap="__e"><view class="menu-left data-v-64c291de"><text class="menu-icon data-v-64c291de">📋</text><text class="menu-label data-v-64c291de">我的订单</text></view><text class="menu-arrow data-v-64c291de">›</text></view><view class="divider data-v-64c291de"></view><view data-event-opts="{{[['tap',[['goMySells',['$event']]]]]}}" class="menu-item data-v-64c291de" bindtap="__e"><view class="menu-left data-v-64c291de"><text class="menu-icon data-v-64c291de">📖</text><text class="menu-label data-v-64c291de">我的卖书</text></view><text class="menu-arrow data-v-64c291de">›</text></view><view class="divider data-v-64c291de"></view><view data-event-opts="{{[['tap',[['goMyWants',['$event']]]]]}}" class="menu-item data-v-64c291de" bindtap="__e"><view class="menu-left data-v-64c291de"><text class="menu-icon data-v-64c291de">🔍</text><text class="menu-label data-v-64c291de">我的求购</text></view><text class="menu-arrow data-v-64c291de">›</text></view></view></view><view class="section data-v-64c291de"><text class="section-title data-v-64c291de">更多</text><view class="menu-card card data-v-64c291de"><view data-event-opts="{{[['tap',[['goSell',['$event']]]]]}}" class="menu-item data-v-64c291de" bindtap="__e"><view class="menu-left data-v-64c291de"><text class="menu-icon data-v-64c291de">✏️</text><text class="menu-label data-v-64c291de">我要卖书</text></view><text class="menu-arrow data-v-64c291de">›</text></view><view class="divider data-v-64c291de"></view><view data-event-opts="{{[[