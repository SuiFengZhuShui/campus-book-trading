<view class="container data-v-85c89c14"><block wx:if="{{loading}}"><view class="status-msg data-v-85c89c14">加载中...</view></block><block wx:else><block wx:if="{{want}}"><view class="card data-v-85c89c14"><text class="title data-v-85c89c14">{{want.title}}</text><view class="meta data-v-85c89c14"><block wx:if="{{want.author}}"><text class="meta-item data-v-85c89c14">{{want.author}}</text></block><block wx:if="{{want.publisher}}"><text class="meta-item data-v-85c89c14">{{want.publisher}}</text></block><block wx:if="{{want.category_name}}"><text class="meta-item data-v-85c89c14">{{want.category_name}}</text></block></view><view class="info-grid data-v-85c89c14"><view class="info-item data-v-85c89c14"><text class="label data-v-85c89c14">最高出价</text><text class="price data-v-85c89c14">{{"¥"+want.max_price}}</text></view><view class="info-item data-v-85c89c14"><text class="label data-v-85c89c14">期望成色</text><text class="value data-v-85c89c14">{{want.condition_label}}</text></view><view class="info-item data-v-85c89c14"><text class="label data-v-85c89c14">发布者</text><text class="value data-v-85c89c14">{{want.publisher_name}}</text></view><view class="info-item data-v-85c89c14"><text class="label data-v-85c89c14">过期时间</text><text class="value data-v-85c89c14">{{want.expires_at}}</text></view></view><text class="{{['data-v-85c89c14','status-tag',$root.m0]}}">{{want.status_label}}</text></view><block wx:if="{{$root.g0}}"><view class="card data-v-85c89c14"><text class="section-title data-v-85c89c14">接单记录</text><block wx:for="{{want.fulfillments}}" wx:for-item="f" wx:for-index="__i0__" wx:key="id"><view class="fulfill-item data-v-85c89c14"><text class="fulfiller data-v-85c89c14">{{f.fulfiller_name}}</text><text class="fulfill-status data-v-85c89c14">{{f.status_label}}</text></view></block></view></block><block wx:if="{{want.status==='active'}}"><view data-event-opts="{{[['tap',[['goSell',['$event']]]]]}}" class="btn-teal sell-btn data-v-85c89c14" bindtap="__e"> 我要卖这本书 </view></block