<view class="container data-v-b5324562"><block wx:if="{{loading}}"><view class="status-msg data-v-b5324562">加载中...</view></block><block wx:else><block wx:if="{{book}}"><block wx:if="{{$root.g0}}"><swiper class="image-swiper data-v-b5324562" indicator-dots="{{true}}" indicator-color="#e5dccf" indicator-active-color="#b49450" circular="{{true}}"><block wx:for="{{book.images}}" wx:for-item="img" wx:for-index="__i0__" wx:key="id"><swiper-item class="data-v-b5324562"><safe-image class="swiper-image data-v-b5324562" vue-id="{{'07754d97-1-'+__i0__}}" src="{{img.url}}" mode="aspectFill" data-event-opts="{{[['^click',[['previewImage',['$0'],[[['book.images','id',img.id,'url']]]]]]]}}" bind:click="__e" bind:__l="__l"></safe-image></swiper-item></block></swiper></block><block wx:else><view class="no-cover data-v-b5324562">暂无图片</view></block><view class="card info-card data-v-b5324562"><text class="title data-v-b5324562">{{book.title}}</text><view class="meta data-v-b5324562"><text class="meta-item data-v-b5324562">{{book.author}}</text><text class="meta-item data-v-b5324562">{{book.publisher}}</text><block wx:if="{{book.isbn}}"><text class="meta-item data-v-b5324562">{{"ISBN "+book.isbn}}</text></block></view><view class="tags data-v-b5324562"><text class="condition-tag data-v-b5324562">{{book.condition_label}}</text><block wx:if="{{book.category}}"><text class="category-tag data-v-b5324562">{{book.category}}</text></block></view><view class="price-row data-v-b5324562"><text class="price data-v-b5324562">{{"¥"+book.price}}</text><block wx:if="{{book.original_price}}"><text class="price-original data-v-b5324562">{{"¥"+book.original_price}}</text></block></view><block wx:if="{{book.description}}"><text class="desc data-v-b5324562">{{book.description}}</text></block></view><block wx:if="{{book.seller}}"><view class="card seller-card data-v-b5324562"><text class="section-title data-v-b5324562">卖家信息</text><view class="seller-row data-v-b5324562"><text class="seller-name data-v-b5324562">{{book.seller.name}}</text><text class="seller-phone data-v-b5324562">{{book.seller.phone}}</text></view></view></block><block wx:if="{{$root.g1}}"><view class="card reviews-card data-v-b5324562"><text class="section-title data-v-b5324562">{{"评价 ("+$root.g2+")"}}</text><block wx:for="{{book.reviews}}" wx:for-item="r" wx:for-index="__i1__" wx:key="id"><view class="review-item data-v-b5324562"><view class="review-header data-v-b5324562"><text class="review-user data-v-b5324562">{{r.user_name}}</text><view class="review-stars data-v-b5324562"><block wx:for="{{5}}" wx:for-item="i" wx:for-index="__i2__" wx:key="*this"><text class="{{['data-v-b5324562',i<=r.book_rating?'star on':'star']}}">★</text></block></view></view><block wx:if="{{r.comment}}"><text class="review-comment data-v-b5324562">{{r.comment}}</text></block><text class="review-date data-v-b5324562">{{r.created_at}}</text></view></block></view></block><view class="bottom-bar data-v-b5324562"><view class="bar-info data-v-b5324562"><text class="price data-v-b5324562">{{"¥"+book.price}}</text><text class="condition data-v-b5324562">{{book.condition_label}}</text></view><view data-event-opts="{{[['tap',[['goBuy',['$event']]]]]}}" class="btn-amber bar-btn data-v-b5324562" bindtap="__e">立即购买</view></view></block></block></view>